# The build product is deliberately NOT committed. Obsidian (and BRAT, and the
# install.sh / install.ps1 installers) download main.js from the GitHub Release
# assets, which .github/workflows/release.yml builds fresh from the tagged
# source. A committed copy drifts silently; a build at tag time cannot.
main.js

node_modules/

# Per-install settings. Obsidian writes this on first load; committing it would
# seed every new install with someone else's choices.
data.json

# Scratch output from the release process.
*.tgz
*.log
.DS_Store

# Test scratch: generated stubs and the instrumented copy of the plugin.
tests/.tmp/
